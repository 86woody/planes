{
  "name": "vscode-bridge",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "publisher": "woody",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "package": "npm run build && node -e \"require('node:fs').mkdirSync('../../release',{recursive:true})\" && vsce package --no-dependencies --allow-missing-repository --skip-license -o ../../release/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mc/contracts": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.6.0"
  }
}